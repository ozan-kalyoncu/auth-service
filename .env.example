# Copy to .env and fill in real values. .env is gitignored; this file is not.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# These URLs are for running the app on the host (`npm run dev`) against the
# compose datastores. Inside docker-compose the app uses the service names
# `postgres` and `redis` instead -- see docker-compose.yml.
#
# Host ports are deliberately NOT the defaults (5432/6379) so this stack can run
# at the same time as another local Postgres/Redis.
DATABASE_URL=postgresql://auth:auth@localhost:5433/auth?schema=public
REDIS_URL=redis://localhost:6380

# Host port mappings used by docker-compose.
POSTGRES_PORT=5433
REDIS_PORT=6380

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Signs ACCESS tokens. There is no refresh-token secret: refresh tokens are
# opaque random strings checked against the database, not signed JWTs.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string

# Access tokens are short-lived because they are not checked against the database
# on every request -- revoking one is impossible before it expires, so it must
# expire fast. Refresh tokens are long-lived but ARE stored, rotated and revocable.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Included in every token and verified on the way back in, so a token minted by
# some other service using the same secret still cannot be used here.
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-service-clients

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Public URL of this service. Used to build the links that go into emails.
# It is configured rather than read from the request's Host header, because that
# header is attacker-controlled -- trusting it would let someone receive a
# "verification" email pointing at their own domain.
APP_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# OAuth2 (milestone 5 -- leave blank until then)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:3000
